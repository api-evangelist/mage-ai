  "info": {
    "_postman_id": "3ec2c5b0-e217-46ee-8b27-c2f571caf5d1",
    "name": "Mage Blocks Pipelines API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API exposed by the self-hosted Mage data pipeline app. It covers triggering pipeline runs via API triggers (pipeline schedules), reading pipeline runs, and managing pipelines, blocks, and pipeline schedules. Requests are authenticated with an api_key (query parameter or request body) plus an OAuth token supplied via the OAUTH-TOKEN header or the oauth_token cookie. The default local server runs on port 6789.\n\nContact Support:\n Name: Mage",
      "type": "text/plain"
    }
  }
